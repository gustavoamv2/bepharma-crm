# BCC Address de HubSpot (ConfiguraciÃ³n â†’ Objects â†’ Activities â†’ Email Log &
# Track â†’ Manual Logging). Se agrega en BCC a cada correo saliente del CRM para
# que HubSpot registre el envio con from/to correctos.
# Default hardcodeado en server.js si no se define: 51580878@bcc.hubspot.com
HUBSPOT_BCC_ADDRESS=51580878@bcc.hubspot.com

# â”€â”€â”€ Resend Inbound (captura de respuestas de clientes) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Dominio de recepcion configurado en Resend (Domains -> Inbound), o el
# *.resend.app que Resend asigne. El Reply-To de cada correo saliente apunta a
# deal-<id>@RESEND_INBOUND_DOMAIN para que la respuesta llegue al webhook
# /api/webhooks/resend-inbound y se loguee en el deal/contacto correcto.
RESEND_INBOUND_DOMAIN=inbound.bepharma.org
# Signing secret del webhook (Resend -> Webhooks -> tu endpoint -> Signing secret)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

